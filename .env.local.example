# ─── Supabase ───────────────────────────────────────────────────────────────
# Get these from: https://supabase.com/dashboard → your project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here   # NEVER expose to client
SUPABASE_PROJECT_ID=your_project_id_here

# ─── DocuSeal ────────────────────────────────────────────────────────────────
# Get from: https://docuseal.co/sign_in → Settings → API
# Self-hosted: set DOCUSEAL_URL to your own instance
DOCUSEAL_API_KEY=your_docuseal_api_key_here
DOCUSEAL_URL=https://api.docuseal.co
# Template IDs — create these in DocuSeal dashboard first
DOCUSEAL_SHE_TEMPLATE_ID=your_she_file_template_id

# ─── PayFast ─────────────────────────────────────────────────────────────────
# Get from: https://www.payfast.co.za → My Account → Settings → API Keys
PAYFAST_MERCHANT_ID=your_merchant_id
PAYFAST_MERCHANT_KEY=your_merchant_key
PAYFAST_PASSPHRASE=your_passphrase_here
# Use sandbox for testing: https://sandbox.payfast.co.za
NEXT_PUBLIC_PAYFAST_URL=https://www.payfast.co.za/eng/process
# Set to 'sandbox' for testing, 'production' for live
PAYFAST_ENV=sandbox

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_SECRET=generate_with_openssl_rand_base64_32

# ─── Pricing (centralised — change here only) ────────────────────────────────
# All amounts in ZAR cents to avoid float issues
NEXT_PUBLIC_FILE_PRICE_STANDARD=450000
NEXT_PUBLIC_FILE_PRICE_VOLUME_A=412500
NEXT_PUBLIC_FILE_PRICE_VOLUME_B=362500
NEXT_PUBLIC_FILE_PRICE_VOLUME_C=312500
NEXT_PUBLIC_PRO_SUBSCRIPTION_PRICE=99900
NEXT_PUBLIC_PLATFORM_FEE_FREE=25
NEXT_PUBLIC_PLATFORM_FEE_PRO=15
