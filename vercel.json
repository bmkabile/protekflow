{
  "buildCommand": "next build",
  "devCommand": "next dev",
  "installCommand": "npm install",
  "framework": "nextjs",
  "outputDirectory": ".next",
  "env": {
    "NEXT_PUBLIC_SUPABASE_URL": "@protekflow_supabase_url",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": "@protekflow_supabase_anon_key",
    "SUPABASE_SERVICE_ROLE_KEY": "@protekflow_service_role_key",
    "DOCUSEAL_API_KEY": "@protekflow_docuseal_key",
    "DOCUSEAL_SHE_TEMPLATE_ID": "@protekflow_docuseal_template",
    "PAYFAST_MERCHANT_ID": "@protekflow_payfast_merchant_id",
    "PAYFAST_MERCHANT_KEY": "@protekflow_payfast_merchant_key",
    "PAYFAST_PASSPHRASE": "@protekflow_payfast_passphrase",
    "NEXTAUTH_SECRET": "@protekflow_nextauth_secret"
  }
}
